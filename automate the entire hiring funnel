{
  "nodes": [
    {
      "parameters": {
        "authentication": "oAuth2",
        "sheetId": "your_google_sheet_id",
        "range": "Sheet1!A:B"
      },
      "id": "1",
      "name": "Read Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "fromEmail": "you@example.com",
        "toEmail": "={{$json[\"Email\"]}}",
        "subject": "First Contact",
        "text": "Hi, just checking in!"
      },
      "id": "2",
      "name": "Send Initial Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "interval": 30,
        "unit": "minutes"
      },
      "id": "3",
      "name": "Wait 30 Minutes",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [600, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [],
          "string": [
            {
              "value1": "={{$json[\"Reply\"]}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "4",
      "name": "Check for Reply",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [800, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "to": "whatsapp_number",
        "message": "User replied to your email."
      },
      "id": "5",
      "name": "Send WhatsApp Notification",
      "type": "n8n-nodes-base.whatsapp",
      "typeVersion": 1,
      "position": [1000, 200]
    },
    {
      "parameters": {
        "fromEmail": "you@example.com",
        "toEmail": "={{$json[\"Email\"]}}",
        "subject": "Follow-up",
        "text": "Just following up to see if you had a chance to review my last message."
      },
      "id": "6",
      "name": "Send Follow-up Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [1000, 400]
    },
    {
      "parameters": {
        "functionCode": "item.attempt = item.attempt ? item.attempt + 1 : 1;\nreturn item;"
      },
      "id": "7",
      "name": "Increment Attempt Count",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1200, 400]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json[\"attempt\"]}}",
              "operation": "smallerEqual",
              "value2": 5
            }
          ]
        }
      },
      "id": "8",
      "name": "Check Max Attempts",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1400, 400]
    }
  ],
  "connections": {
    "Read Google Sheet": {
      "main": [
        [
          {
            "node": "Send Initial Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Initial Email": {
      "main": [
        [
          {
            "node": "Wait 30 Minutes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 30 Minutes": {
      "main": [
        [
          {
            "node": "Check for Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check for Reply": {
      "main": [
        [
          {
            "node": "Send WhatsApp Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Follow-up Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Follow-up Email": {
      "main": [
        [
          {
            "node": "Increment Attempt Count",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Increment Attempt Count": {
      "main": [
        [
          {
            "node": "Check Max Attempts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Max Attempts": {
      "main": [
        [
          {
            "node": "Wait 30 Minutes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
